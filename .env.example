# Supabase project credentials (from Supabase Dashboard > Project Settings > API)
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Feature flag modul CRM/outreach (default aktif). Set "false" untuk
# menyembunyikan menu + memblokir route CRM tanpa mengubah website publik.
VITE_ENABLE_CRM=true
# Sub-modul CRM (default aktif). Inbound default OFF sampai app review Meta siap.
VITE_ENABLE_OUTREACH=true
VITE_ENABLE_CAMPAIGNS=true
VITE_ENABLE_REFERRAL=true
VITE_ENABLE_INBOUND=false

# Server-only Supabase credentials (Vercel Environment Variables; never prefix with VITE_)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# Instagram Graph API / Meta webhook (server-only)
IG_GRAPH_VERSION=v23.0
IG_USER_ID=YOUR-INSTAGRAM-PROFESSIONAL-ACCOUNT-ID
IG_ACCESS_TOKEN=YOUR-LONG-LIVED-ACCESS-TOKEN
IG_APP_SECRET=YOUR-META-APP-SECRET
IG_WEBHOOK_VERIFY_TOKEN=GENERATE-A-RANDOM-VERIFY-TOKEN
IG_AUTOMATION_SECRET=GENERATE-A-DIFFERENT-RANDOM-SECRET

# Telegram notification target (server-only)
TELEGRAM_BOT_TOKEN=YOUR-BOTFATHER-TOKEN
TELEGRAM_NOTIFICATION_CHAT_ID=YOUR-GROUP-OR-CHANNEL-CHAT-ID
APP_URL=https://jokitugasit.my.id

# Optional: engineer seed credentials (used by supabase/seed.sql setup guide)
# Not read by the app.
